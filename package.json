{
  "name": "nite-cms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@nite/admin",
    "dev:api": "turbo run dev --filter=@nite/cms-api",
    "db:migrate": "npm run db:migrate --workspace=@nite/cms-db",
    "db:migrate:local": "npm run db:migrate:local --workspace=@nite/cms-db",
    "test:postgres:up": "docker compose --env-file .env.postgres-test.local -f compose.postgres-test.yml up -d --wait",
    "test:postgres:down": "docker compose --env-file .env.postgres-test.local -f compose.postgres-test.yml down",
    "test:postgres:local": "npm run test:postgres:local --workspace=@nite/editorial",
    "test:e2e:configured": "npm run test:e2e:configured --workspace=@nite/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:vm-deployment": "node --test deploy/vm/outbox-scheduler.test.mjs scripts/vm-deployment.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:deadcode": "knip",
    "check": "npm run format:check && npm run check:deadcode && turbo run lint typecheck && turbo run test && turbo run build"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "knip": "6.32.0",
    "prettier": "^3.8.3",
    "turbo": "2.10.9",
    "typescript": "^5"
  }
}
