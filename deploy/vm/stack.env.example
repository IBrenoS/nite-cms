# Copie para stack.env e ajuste para os domínios e imagens do ambiente.
CMS_ADMIN_DOMAIN=redacao.example.org
CMS_API_DOMAIN=api.redacao.example.org
ACME_EMAIL=infra@example.org

CMS_ADMIN_IMAGE=nite-redacao-admin
CMS_API_IMAGE=nite-redacao-api
CMS_SCHEDULER_IMAGE=nite-redacao-scheduler
CMS_MIGRATION_IMAGE=nite-redacao-migration
CMS_IMAGE_TAG=local

CMS_ADMIN_ENV_FILE=./deploy/vm/admin.env
CMS_API_ENV_FILE=./deploy/vm/api.env
CMS_SCHEDULER_ENV_FILE=./deploy/vm/scheduler.env
CMS_MIGRATION_ENV_FILE=./deploy/vm/migration.env

ADMIN_MEMORY_LIMIT=1536m
ADMIN_CPU_LIMIT=1.50
API_MEMORY_LIMIT=512m
API_CPU_LIMIT=0.75
CADDY_MEMORY_LIMIT=256m
CADDY_CPU_LIMIT=0.50
SCHEDULER_MEMORY_LIMIT=128m
SCHEDULER_CPU_LIMIT=0.25
MIGRATION_MEMORY_LIMIT=512m
MIGRATION_CPU_LIMIT=0.50
